# Ontario Bottle Tracker — environment variables
# Copy this file to .env.local and fill in your values.
# .env.local is gitignored — never commit API keys.

# ── Community barcode contributions ────────────────────────────────────────
# Set this to your GitHub repository's issue URL to enable the
# "Contribute to community DB" prompt in the scanner.
# Replace YOUR_USERNAME and YOUR_REPO_NAME with your actual values.
#
VITE_CONTRIBUTE_URL=https://github.com/YOUR_USERNAME/YOUR_REPO_NAME/issues/new?template=barcode-contribution.yml

# ── (Phase 2) LCBO product lookup — not yet implemented ────────────────────
# VITE_LCBO_PROXY_URL=https://your-cloudflare-worker.workers.dev/lcbo

# ── Google Sheets export ────────────────────────────────────────────────────
# Required to enable "Export to Google Sheets" in the app.
#
# Setup (5 minutes):
#  1. Go to https://console.cloud.google.com
#  2. Create a new project (or use existing)
#  3. APIs & Services → Enable APIs → enable "Google Sheets API" and "Google Drive API"
#  4. APIs & Services → Credentials → Create Credentials → OAuth 2.0 Client ID
#  5. Application type: Web application
#  6. Authorised redirect URIs — add BOTH:
#       http://localhost:5173/
#       https://YOUR_USERNAME.github.io/YOUR_REPO_NAME/
#  7. Copy the Client ID (the long string ending in .apps.googleusercontent.com)
#     Do NOT copy the client secret — it is not needed and should stay private
#
VITE_GOOGLE_CLIENT_ID=YOUR_CLIENT_ID.apps.googleusercontent.com
